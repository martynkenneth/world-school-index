{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run data:validate && npm run data:export && vinext build",
    "build:netlify": "npm run data:validate && npm run data:export && vite build",
    "start": "vinext start",
    "data:fetch": "node --experimental-strip-types scripts/fetch.ts",
    "data:extract": "node --experimental-strip-types scripts/extract.ts",
    "data:reverify-all": "node --experimental-strip-types scripts/reverify-all.ts",
    "data:gap-report": "node --experimental-strip-types scripts/gap-report.ts",
    "data:validate": "node --experimental-strip-types scripts/validate.ts --run",
    "data:export": "node --experimental-strip-types scripts/export-data.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/data-pipeline.test.mjs tests/rendered-html.test.mjs tests/city-guide-rendered.test.mjs tests/parent-perspectives.test.mjs",
    "test:gap-report": "node --experimental-strip-types --test tests/gap-report.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .netlify",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ajv": "^8.17.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
