{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-school-index-vietnam.martynkenneth.chatgpt.site/schema/city-guide.schema.json",
  "title": "World School Index city living guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "country",
    "country_slug",
    "city",
    "city_slug",
    "topic",
    "title",
    "description",
    "canonical_path",
    "published_date",
    "checked_date",
    "recheck_date",
    "sitemap",
    "direct_answer",
    "key_facts",
    "sections",
    "family_section",
    "internal_links",
    "sources"
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 30 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publisher", "title", "url", "source_type", "retrieved_date", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "publisher": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "pattern": "^https://" },
        "source_type": {
          "enum": [
            "municipal-government",
            "national-government",
            "national-tourism-authority",
            "official-airport",
            "official-public-transport",
            "official-health-provider",
            "official-emergency-service",
            "official-heritage-venue",
            "official-cultural-institution",
            "official-property-source",
            "authoritative-secondary"
          ]
        },
        "retrieved_date": { "$ref": "#/$defs/date" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/slug" },
    "country": { "type": "string", "minLength": 2 },
    "country_slug": { "$ref": "#/$defs/slug" },
    "city": { "type": "string", "minLength": 2 },
    "city_slug": { "$ref": "#/$defs/slug" },
    "topic": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 20, "maxLength": 80 },
    "description": { "type": "string", "minLength": 50, "maxLength": 180 },
    "canonical_path": {
      "type": "string",
      "pattern": "^/guides/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+/$"
    },
    "published_date": { "$ref": "#/$defs/date" },
    "checked_date": { "$ref": "#/$defs/date" },
    "recheck_date": { "$ref": "#/$defs/date" },
    "sitemap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "change_frequency", "priority"],
      "properties": {
        "include": { "const": true },
        "change_frequency": { "enum": ["weekly", "monthly", "yearly"] },
        "priority": { "type": "number", "minimum": 0.1, "maximum": 1 }
      }
    },
    "direct_answer": { "$ref": "#/$defs/sourcedText" },
    "key_facts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "answer", "source_ids"],
        "properties": {
          "label": { "type": "string", "minLength": 3 },
          "answer": { "type": "string", "minLength": 15 },
          "source_ids": { "$ref": "#/$defs/sourceIds" }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "paragraphs", "items"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "heading": { "type": "string", "minLength": 8 },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/sourcedText" }
          },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/sourcedText" }
          }
        }
      }
    },
    "family_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs", "checklist"],
      "properties": {
        "heading": { "const": "For families comparing schools" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 30 }
        },
        "checklist": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 15 }
        }
      }
    },
    "internal_links": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href", "purpose"],
        "properties": {
          "label": { "type": "string", "minLength": 3 },
          "href": { "type": "string", "pattern": "^/" },
          "purpose": { "enum": ["city-hub", "country-hub", "school-directory"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/source" }
    }
  }
}
